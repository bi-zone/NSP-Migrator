# -- Docker Images ----------------------------------------------------------
PYTHON_IMAGE=python:3.12-alpine
POSTGRES_IMAGE=postgres:15

# --- App -------------------------------------------------------------------
APP_NAME=policy-migrator-ratel
APP_VERSION=26.1.0
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_API_VERSION=v1
APP_API_SLUG=policy-migrator
APP_PUBLIC_BASE_URL=http://localhost:8000
APP_CONTACT_NAME=Team Ratel
APP_CONTACT_EMAIL=ratel@bi.zone
APP_LOG_LEVEL=INFO
APP_DB_ECHO=false
APP_DB_POOL_SIZE=5
APP_DB_MAX_OVERFLOW=10

# --- PostgreSQL (Compose service "postgres", not published to the host) ----
APP_DB_HOST=postgres
APP_DB_PORT=5432
APP_DB_USER=postgres
APP_DB_PASSWORD=postgres
APP_DB_NAME=policy_migrator

# --- Host ports (change if occupied) ---------------------------------------
STREAMLIT_HOST_PORT=8501
API_HOST_PORT=8000

# --- SD-WAN CSP (single-profile release) -----------------------------------
# URL hostname must match the CSP TLS certificate.
APP_SDWAN_CSP_API_URL=https://your-csp-host.example.com
# In-container path; Compose mounts ./client_cert.pem here read-only.
APP_SDWAN_CSP_CERT=/app/client_cert.pem
APP_SDWAN_CSP_USERNAME=your-user
APP_SDWAN_CSP_PASSWORD=your-password
# Needed before mapping / execute against a VPC.
APP_SDWAN_VPC_ID=your-vpc-id

# Optional: closed stand without public DNS (Compose extra_hosts overlay).
# Set BOTH, or leave BOTH empty for normal DNS.
# Example:
# APP_SDWAN_CSP_HOSTNAME=ui.csp.local
# APP_SDWAN_CSP_HOST_IP=10.7.7.7
APP_SDWAN_CSP_HOSTNAME=
APP_SDWAN_CSP_HOST_IP=